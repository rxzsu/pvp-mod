{
	"schemaVersion": 1,
	"id": "pvp-mod",
	"version": "${version}",
	"name": "PvP Mod",
	"description": "Client-side PvP utility mod: Keystrokes HUD, Fullbright, Toggle Sprint, Zoom, effect/overlay removals, coords/FPS/ping HUD. Configured via ModMenu.",
	"authors": [
		"reqwai"
	],
	"contact": {
		"sources": "https://github.com/FUXKVOB/pvp-mod"
	},
	"license": "MIT",
	"icon": "assets/pvp-mod/icon.webp",
	"environment": "client",
	"entrypoints": {
		"main": [
			"pvp.mod.PvpMod"
		],
		"client": [
			"pvp.mod.client.PvpModClient"
		],
		"modmenu": [
			"pvp.mod.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"pvp-mod.mixins.json",
		{
			"config": "pvp-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.14.0"
	},
	"suggests": {
		"modmenu": ">=20.0.0"
	}
}